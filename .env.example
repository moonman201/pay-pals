# Copy to .env.local and fill in. Never commit .env.local.

# PayPal sandbox app (developer.paypal.com/dashboard -> Apps & Credentials -> Sandbox)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Same sandbox client id, exposed to the browser for the PayPal and Venmo buttons
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Sandbox test accounts (developer.paypal.com/dashboard -> Sandbox accounts)
SANDBOX_BUYER_EMAIL=
SANDBOX_SELLER_PERSONAL_EMAIL=
SANDBOX_SELLER_BUSINESS_EMAIL=

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Channel3 (trychannel3.com/developers, promo code PAYPAL-HACKATHON-2026)
CHANNEL3_API_KEY=

# PSA public API (psacard.com, Account > API) for the Buyer Pal cert check
PSA_API_TOKEN=

# Neon Postgres
DATABASE_URL=
# Separate database the packages/db integration tests may truncate. Never the same as DATABASE_URL.
TEST_DATABASE_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Test knob. Set to 1 to ignore every key above and run on the memory store, rules-only pals, fixture prices and the mock PayPal gateway.
# PAY_PALS_DEMO_ONLY=1
