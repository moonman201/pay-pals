{
  "name": "pay-pals",
  "version": "0.1.0",
  "private": true,
  "description": "Two AI agents, one safe deal. Built for the PayPal AI Hackathon, sandbox only.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "npm run e2e -w tests/e2e",
    "test:e2e:real": "npm run e2e:real -w tests/e2e"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
