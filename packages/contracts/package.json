{
  "name": "@pay-pals/contracts",
  "version": "1.8.0",
  "private": true,
  "description": "Shared types, deal state table, agent and PayPal interfaces, and demo fixtures. Every other package builds against this one.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
