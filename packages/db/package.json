{
  "name": "@pay-pals/db",
  "version": "0.1.0",
  "private": true,
  "description": "Drizzle schema (defined by the Lead), repositories and the deal state machine (built by builder-paypal).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./schema.ts",
      "default": "./schema.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && tsx scripts/generate-migrations.ts",
    "db:bundle": "tsx scripts/generate-migrations.ts",
    "db:backfill-hashes": "tsx scripts/backfill-hashes.ts",
    "db:delete-seeded-demo-deals": "tsx scripts/delete-seeded-demo-deals.ts"
  },
  "dependencies": {
    "@pay-pals/contracts": "*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.0"
  }
}
